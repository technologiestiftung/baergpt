{
	"name": "baergpt",
	"version": "0.0.0",
	"description": "![](https://img.shields.io/badge/Built%20with%20%E2%9D%A4%EF%B8%8F-at%20Technologiestiftung%20Berlin-blue)",
	"scripts": {
		"test": "turbo run test",
		"test:e2e": "turbo run test:e2e",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"lint:check": "turbo run lint:check",
		"lint:write": "turbo run lint:write",
		"format:check": "oxfmt --config ./libs/oxfmt/index.js --check .",
		"format:write": "oxfmt --config ./libs/oxfmt/index.js --write .",
		"sql:format:check": "node scripts/check-sql-format.mjs",
		"sql:format:write": "node scripts/check-sql-format.mjs --write",
		"dev": "turbo run dev"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/technologiestiftung/baergpt.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/technologiestiftung/baergpt/issues"
	},
	"homepage": "https://github.com/technologiestiftung/baergpt#readme",
	"packageManager": "npm@11.17.0",
	"workspaces": [
		"apps/*",
		"libs/*"
	],
	"devDependencies": {
		"@repo/oxfmt": "file:libs/oxfmt",
		"@repo/oxlint": "file:libs/oxlint",
		"oxfmt": "0.61.0",
		"oxlint": "1.76.0",
		"sql-formatter": "15.8.2",
		"supabase": "2.40.7",
		"turbo": "2.9.14"
	}
}
