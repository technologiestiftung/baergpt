{
  "name": "baergpt",
  "version": "0.0.0",
  "description": "![](https://img.shields.io/badge/Built%20with%20%E2%9D%A4%EF%B8%8F-at%20Technologiestiftung%20Berlin-blue)",
  "scripts": {
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint:check": "turbo run lint:check",
    "lint:write": "turbo run lint:write",
    "prettier:check": "prettier --check \"**/*.{ts,tsx,md,sql}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx,md,sql}\"",
    "dev": "turbo run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/technologiestiftung/baergpt.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/technologiestiftung/baergpt/issues"
  },
  "homepage": "https://github.com/technologiestiftung/baergpt#readme",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "overrides": {
    "esbuild": "0.28.1",
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.9",
    "protobufjs": "8.7.1",
    "tar": "7.5.22",
    "playwright-core": "1.62.1"
  },
  "devDependencies": {
    "@repo/eslint": "file:libs/eslint",
    "@repo/prettier": "file:libs/prettier",
    "supabase": "2.110.0",
    "turbo": "2.10.7"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "@sentry/cli@2.58.6": true,
    "esbuild@0.28.1": true,
    "supabase@2.71.0": true
  }
}
