# Supply-chain hardening (requires npm >= 11.16, pinned via packageManager in package.json).
# Fail the install if a dependency has install scripts not approved in package.json#allowScripts,
# instead of running them with a warning. Approve after review with `npm approve-scripts <pkg>`.
strict-allow-scripts=true
# Refuse versions younger than 3 days, which also covers transitive deps that Renovate's
# minimumReleaseAge doesn't (e.g. lockfile maintenance). Kept equal to the vulnerabilityAlerts
# delay in .github/renovate.json so security updates can still be installed. npm ci doesn't apply
# it to the lockfile, so .github/scripts/check-lockfile-age.mts enforces it on PRs before install.
min-release-age=3
