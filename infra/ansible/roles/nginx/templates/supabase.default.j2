# Tor exits and Mullvad ranges, maintained by anon-egress-blocklist.timer.
geo $anon_egress {
    default 0;
    include /etc/nginx/anon-egress-blocklist.conf;
}

server {
    listen 80;
    listen [::]:80 default_server;
    server_name {{ domain }};

    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl default_server;
    server_name {{ domain }};

    ssl_certificate /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 50M;

    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Strict-Transport-Security "max-age=86400; includeSubDomains" always;

    if ($anon_egress) {
        return 403;
    }
    error_page 403 @anon_egress_blocked;

    location @anon_egress_blocked {
        access_log /var/log/nginx/anon-egress.log;
        default_type text/plain;
        return 403 "Access via Tor or VPN exit nodes is blocked. Disconnect and try again.";
    }

    # Users are created via OTP (DISABLE_SIGNUP must stay false), so close GoTrue's password signup here.
    location ^~ /auth/v1/signup {
        return 404;
    }

    # Password recovery is unused since login is OTP-only.
    location ^~ /auth/v1/recover {
        return 404;
    }

    # Realtime is unused; its management API accepts the public anon key.
    location ^~ /realtime/v1/ {
        return 404;
    }

    # Logflare's dashboard has no auth in single-tenant mode. Vector ships logs via kong:8000
    # inside the Docker network, so blocking the public path doesn't affect ingestion.
    location ^~ /analytics/ {
        return 404;
    }

    location / {
        proxy_pass http://localhost:8000;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # nginx is the public edge, so don't trust a client-supplied X-Forwarded-For.
        # Overwrite it with the real peer IP — this is the value GoTrue keys its rate
        # limiter on, so appending the client value let attackers rotate the key.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
