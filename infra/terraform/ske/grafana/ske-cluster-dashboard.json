{
  "__inputs": [],
  "__requires": [],
  "title": "SKE — Cluster & workloads",
  "uid": null,
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "ske",
    "kubernetes",
    "otel",
    "stackit"
  ],
  "templating": {
    "list": [
      {
        "name": "ds_metrics",
        "label": "Metrics datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Thanos",
          "value": "Thanos"
        },
        "hide": 0
      },
      {
        "name": "ds_logs",
        "label": "Logs datasource",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "Loki",
          "value": "Loki"
        },
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_metrics}"
        },
        "query": "label_values(k8s_pod_phase{source=\"ske\"}, k8s_namespace_name)",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Health — $namespace",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Deployments: available replicas",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "100 * k8s_deployment_available{source=\"ske\", k8s_namespace_name=\"$namespace\"} / k8s_deployment_desired{source=\"ske\", k8s_namespace_name=\"$namespace\"}",
          "legendFormat": "{{k8s_deployment_name}}"
        }
      ],
      "description": "Available ÷ desired replicas per Deployment. Below 100% means pods are missing, crashing or still rolling out.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        }
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal"
      }
    },
    {
      "type": "stat",
      "title": "Container restarts (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum(delta(k8s_container_restarts{source=\"ske\", k8s_namespace_name=\"$namespace\"}[1h])) or vector(0)"
        }
      ],
      "description": "Crashes and OOM kills both show up here; check the events panel below for the reason.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Pods not running",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "count(k8s_pod_phase{source=\"ske\", k8s_namespace_name=\"$namespace\"} != 2) or vector(0)"
        }
      ],
      "description": "Pods in phase Pending, Failed or Unknown (k8s_pod_phase: 1 pending, 2 running, 3 succeeded, 4 failed, 5 unknown).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "gauge",
      "title": "Quota: memory limits used",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "100 * sum(k8s_resource_quota_used{source=\"ske\", k8s_namespace_name=\"$namespace\", resource=\"limits.memory\"}) / sum(k8s_resource_quota_hard_limit{source=\"ske\", k8s_namespace_name=\"$namespace\", resource=\"limits.memory\"})"
        }
      ],
      "description": "Share of the namespace ResourceQuota (infra/terraform/ske var.namespaces). A rolling update needs headroom for one extra pod; at 100% new pods are rejected.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      }
    },
    {
      "type": "gauge",
      "title": "Quota: CPU requests used",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "100 * sum(k8s_resource_quota_used{source=\"ske\", k8s_namespace_name=\"$namespace\", resource=\"requests.cpu\"}) / sum(k8s_resource_quota_hard_limit{source=\"ske\", k8s_namespace_name=\"$namespace\", resource=\"requests.cpu\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      }
    },
    {
      "type": "row",
      "title": "Containers — $namespace",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Memory % of limit",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "100 * sum by (k8s_pod_name, k8s_container_name) (container_memory_working_set_bytes{source=\"ske\", k8s_namespace_name=\"$namespace\"}) / on (k8s_pod_name, k8s_container_name) sum by (k8s_pod_name, k8s_container_name) (k8s_container_memory_limit_bytes{source=\"ske\", k8s_namespace_name=\"$namespace\"})",
          "legendFormat": "{{k8s_pod_name}} / {{k8s_container_name}}"
        }
      ],
      "description": "Working set ÷ memory limit. The kernel OOM-kills the container at 100%.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "last",
            "max"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memory working set",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum by (k8s_pod_name, k8s_container_name) (container_memory_working_set_bytes{source=\"ske\", k8s_namespace_name=\"$namespace\"})",
          "legendFormat": "{{k8s_pod_name}} / {{k8s_container_name}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "max by (k8s_container_name) (k8s_container_memory_limit_bytes{source=\"ske\", k8s_namespace_name=\"$namespace\"})",
          "legendFormat": "limit {{k8s_container_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^limit .*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "last",
            "max"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "CPU (cores)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum by (k8s_pod_name, k8s_container_name) (container_cpu_usage{source=\"ske\", k8s_namespace_name=\"$namespace\"})",
          "legendFormat": "{{k8s_pod_name}} / {{k8s_container_name}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "max by (k8s_container_name) (k8s_container_cpu_request{source=\"ske\", k8s_namespace_name=\"$namespace\"})",
          "legendFormat": "request {{k8s_container_name}}"
        }
      ],
      "description": "No CPU limits are set (they cause throttling), so usage above the request is allowed while the node has spare CPU.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^request .*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "last",
            "max"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Restarts (total per container)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "max by (k8s_pod_name, k8s_container_name) (k8s_container_restarts{source=\"ske\", k8s_namespace_name=\"$namespace\"})",
          "legendFormat": "{{k8s_pod_name}} / {{k8s_container_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "last",
            "max"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Network I/O per pod",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum by (k8s_pod_name, direction) (rate(k8s_pod_network_io_bytes_total{source=\"ske\", k8s_namespace_name=\"$namespace\"}[5m]))",
          "legendFormat": "{{k8s_pod_name}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "last",
            "max"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Pod ephemeral disk",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum by (k8s_pod_name) (k8s_pod_filesystem_usage_bytes{source=\"ske\", k8s_namespace_name=\"$namespace\"})",
          "legendFormat": "{{k8s_pod_name}}"
        }
      ],
      "description": "Container writable layers + emptyDir + logs. Pods are evicted when the node's disk runs low.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "last",
            "max"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "Nodes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Node memory used %",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "h": 8,
        "w": 7,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "100 * k8s_node_memory_working_set_bytes{source=\"ske\"} / (k8s_node_memory_working_set_bytes{source=\"ske\"} + k8s_node_memory_available_bytes{source=\"ske\"})",
          "legendFormat": "{{k8s_node_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "last",
            "max"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Node CPU (cores used)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "h": 8,
        "w": 7,
        "x": 7,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "k8s_node_cpu_usage{source=\"ske\"}",
          "legendFormat": "{{k8s_node_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "last",
            "max"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Node disk used %",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 14,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "100 * k8s_node_filesystem_usage_bytes{source=\"ske\"} / k8s_node_filesystem_capacity_bytes{source=\"ske\"}",
          "legendFormat": "{{k8s_node_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "calcs": [
            "last"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Telemetry collectors ready",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum(k8s_container_ready{source=\"ske\", k8s_namespace_name=\"observability\"}) / count(k8s_container_ready{source=\"ske\", k8s_namespace_name=\"observability\"})"
        }
      ],
      "description": "otel-collector pods (one per node + the cluster collector). Below 100% means some logs/metrics are not being shipped. If this panel is empty, the cluster collector itself is down.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "row",
      "title": "Events & logs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Warning events — $namespace",
      "datasource": {
        "type": "loki",
        "uid": "${ds_logs}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_logs}"
          },
          "expr": "{service_name=\"ske-events\"} | json | object_type=\"Warning\" | object_regarding_namespace=\"$namespace\" | line_format \"{{.object_regarding_kind}}/{{.object_regarding_name}}  {{.object_reason}}: {{.object_note}}\""
        }
      ],
      "description": "Kubernetes Warning events (BackOff, Unhealthy, FailedScheduling, Evicted, …) from the cluster collector.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "type": "timeseries",
      "title": "Log volume by namespace",
      "datasource": {
        "type": "loki",
        "uid": "${ds_logs}"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
