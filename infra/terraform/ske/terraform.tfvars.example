# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
project_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" # baergpt-berlin-prod
region     = "eu01"

# Check available versions before setting: `stackit ske options` or the portal.
kubernetes_version_min = "1.36"

observability_instance_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" # `stackit observability instance list`
# observability_project_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" # only if the instance lives in another project

# machine_type = "g1a.4d"
# availability_zones = ["eu01-1", "eu01-2", "eu01-3"]
# node_pool_min = 3
# node_pool_max = 5

# Cluster platform layer
letsencrypt_email = "infra@ts.berlin"
# letsencrypt_acme_server: see variables.tf for using LE staging on a new cluster.

# namespaces: the defaults in variables.tf match the resources in infra/k8s.
