# Copy to .op.env.ske and point the refs at your real STACKIT items in 1Password.
# Holds op:// REFERENCES only — no secret values. `op run` resolves them at runtime:
#
#   op run --env-file .op.env.ske -- terraform plan
#
STACKIT_SERVICE_ACCOUNT_KEY=op://<vault>/<stackit-prod-service-account-item>/<field>

# REQUIRED: S3 backend (versions.tf) authenticates SEPARATELY with an objectstorage
# credential. Without these even `terraform init` fails — there is no metadata-service
# fallback. Same bucket/credential the cloud-foundry and observability modules use.
AWS_ACCESS_KEY_ID=op://<vault>/<tfstate-objectstorage-credential>/access_key
AWS_SECRET_ACCESS_KEY=op://<vault>/<tfstate-objectstorage-credential>/secret_access_key
