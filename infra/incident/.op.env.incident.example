# Copy to .op.env.incident and point the refs at the STACKIT Observability instance credentials.
LOKI_URL=op://<vault>/<observability-item>/loki-url
LOKI_USERNAME=op://<vault>/<observability-item>/username
LOKI_PASSWORD=op://<vault>/<observability-item>/password

# Render service id of the production backend: the value of render_backend_resource in production.tfvars.
RENDER_BACKEND_RESOURCE=srv-CHANGEME
