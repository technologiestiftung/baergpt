{
	"name": "baergpt-backend",
	"version": "0.0.0",
	"scripts": {
		"check-types": "tsc --noEmit",
		"build": "tsc",
		"build:prod": "npm run build && npm run build:sourcemaps",
		"build:sourcemaps": "sentry-cli sourcemaps inject --org $SENTRY_ORG --project $SENTRY_PROJECT ./dist && sentry-cli sourcemaps upload --org $SENTRY_ORG --project $SENTRY_PROJECT ./dist",
		"start": "tsc && node --env-file-if-exists=.env dist/src/index.js",
		"dev": "tsx --watch ./src/index.ts",
		"test": "vitest run src",
		"test:watch": "vitest watch src",
		"lint:check": "ESLINT_USE_FLAT_CONFIG=true eslint \"src/**/*\"",
		"lint:write": "ESLINT_USE_FLAT_CONFIG=true eslint \"src/**/*\" --fix",
		"lint:db": "./supabase/lint-database.sh",
		"prettier:check": "prettier --check src supabase",
		"prettier:write": "prettier --write src supabase",
		"db:reset": "supabase db reset && npm run db:typegen && npm run db:upload-default-documents && npm run db:localseed",
		"db:typegen": "supabase gen types --lang typescript --local > ../../libs/db-schema/index.ts && prettier --write ../../libs/db-schema/index.ts && ESLINT_USE_FLAT_CONFIG=true eslint --fix ../../libs/db-schema/index.ts",
		"db:localseed": "tsx supabase/scripts/local-seed.ts",
		"db:upload-default-documents": "tsx ./supabase/scripts/upload-default-documents.ts",
		"db:backfill-mistral": "tsx ./supabase/backfill-mistral-embeddings.ts",
		"db:dump-user-emails": "tsx ./supabase/scripts/dump-user-emails.ts",
		"db:up": "supabase migration up --local && npm run db:typegen",
		"db:dump-schema": "supabase db dump --local --schema public > supabase/schemas/schema.sql && prettier --write supabase/schemas/schema.sql",
		"db:generate-migration": "supabase db diff --schema public -f",
		"mistral:assess-orphans": "tsx supabase/scripts/cleanup-mistral-orphans.ts -- --dry-run",
		"mistral:cleanup-orphans": "tsx supabase/scripts/cleanup-mistral-orphans.ts",
		"s3:assess-orphans": "tsx supabase/scripts/cleanup-s3-orphans.ts -- --dry-run",
		"s3:cleanup-orphans": "tsx supabase/scripts/cleanup-s3-orphans.ts",
		"auth:assess-password-rotation": "tsx supabase/scripts/rotate-user-passwords.ts -- --dry-run",
		"auth:rotate-passwords": "tsx supabase/scripts/rotate-user-passwords.ts"
	},
	"dependencies": {
		"@ai-sdk/mcp": "2.0.34",
		"@ai-sdk/mistral": "4.0.31",
		"@dqbd/tiktoken": "1.0.22",
		"@hono/node-server": "2.0.12",
		"@langfuse/client": "5.10.0",
		"@langfuse/core": "5.10.0",
		"@langfuse/otel": "5.10.0",
		"@langfuse/tracing": "5.10.0",
		"@langfuse/vercel-ai-sdk": "5.10.0",
		"@mistralai/mistralai": "2.6.3",
		"@opentelemetry/instrumentation-http": "0.221.0",
		"@opentelemetry/instrumentation-undici": "0.31.0",
		"@opentelemetry/sdk-node": "0.221.0",
		"@opentelemetry/sdk-trace-node": "2.10.0",
		"@repo/db-schema": "file:../../libs/db-schema",
		"@sentry/node": "10.68.0",
		"@supabase/supabase-js": "2.81.1",
		"ai": "7.0.73",
		"dotenv": "16.6.1",
		"hono": "4.13.0",
		"ioredis": "5.11.1",
		"jsonwebtoken": "9.0.3",
		"mammoth": "1.12.0",
		"mistral-tokenizer-ts": "2.2.1",
		"pdf-lib": "1.17.1",
		"unpdf": "1.8.0",
		"xlsx": "npm:@e965/xlsx@0.20.3",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "3.1007.0",
		"@repo/typescript-config": "file:../../libs/typescript-config",
		"@types/node": "22.5.0",
		"@types/pdf-parse": "1.1.4",
		"@types/supertest": "6.0.3",
		"date-fns": "4.1.0",
		"globals": "15.15.0",
		"nodemon": "3.1.4",
		"supertest": "7.1.3",
		"tsx": "4.23.1",
		"typescript": "5.8.3",
		"vitest": "4.1.10"
	},
	"overrides": {
		"zod": "4.4.3"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "*"
	}
}
