{
	"rewrites": [{ "source": "/(.*)", "destination": "/" }],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{ "key": "X-Frame-Options", "value": "DENY" },
				{
					"key": "Content-Security-Policy",
					"value": "frame-ancestors 'none'; img-src 'self' data: blob: https://logos.citylab-berlin.org"
				}
			]
		}
	]
}
