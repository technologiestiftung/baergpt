{
	"name": "baergpt-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"check-types": "tsc --noEmit",
		"lint:check": "ESLINT_USE_FLAT_CONFIG=true eslint \"src/**/*\"",
		"lint:write": "ESLINT_USE_FLAT_CONFIG=true eslint \"src/**/*\" --fix",
		"playwright:install": "npx playwright install --with-deps",
		"prettier:check": "prettier  --check .",
		"prettier:write": "prettier --write .",
		"preview": "vite preview",
		"test": "vitest run src --passWithNoTests",
		"test:watch": "vitest watch src",
		"test:a11y": "npx playwright test tests/a11y --config=playwright.config.ts",
		"test:e2e": "npx playwright test tests/e2e --config=playwright.config.ts"
	},
	"dependencies": {
		"@e965/xlsx": "0.20.3",
		"@mohtasham/md-to-docx": "3.0.1",
		"@react-pdf/renderer": "4.5.1",
		"@repo/db-schema": "file:../../libs/db-schema",
		"@sentry/react": "10.68.0",
		"@supabase/supabase-js": "2.81.1",
		"date-fns": "3.6.0",
		"dotenv": "16.6.1",
		"js-tiktoken": "1.0.21",
		"react": "19.2.8",
		"react-data-grid": "7.0.0-beta.61",
		"react-dnd": "16.0.1",
		"react-dnd-html5-backend": "16.0.1",
		"react-dom": "19.2.8",
		"react-dropzone": "14.4.1",
		"react-markdown": "9.1.0",
		"react-router": "8.3.0",
		"rehype-stringify": "10.0.1",
		"remark-gfm": "4.0.1",
		"remark-rehype": "11.1.2",
		"remove-markdown": "0.6.4",
		"slugify": "1.6.9",
		"zustand": "5.0.14"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1",
		"@playwright/test": "1.62.1",
		"@repo/typescript-config": "file:../../libs/typescript-config",
		"@sentry/vite-plugin": "5.4.0",
		"@types/node": "22.20.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.4",
		"autoprefixer": "10.5.4",
		"globals": "15.15.0",
		"postcss": "8.5.25",
		"strip-literal": "2.1.1",
		"tailwindcss": "3.4.19",
		"typescript": "5.9.3",
		"vite": "8.1.5",
		"vitest": "4.1.10"
	},
	"overrides": {
		"whatwg-url": "14.2.0"
	}
}
