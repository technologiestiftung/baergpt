{
	"name": "baergpt-maintenance-mode",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"check-types": "tsc --noEmit",
		"lint:check": "ESLINT_USE_FLAT_CONFIG=true eslint \"src/**/*\"",
		"lint:write": "ESLINT_USE_FLAT_CONFIG=true eslint \"src/**/*\" --fix",
		"prettier:check": "prettier  --check .",
		"prettier:write": "prettier --write .",
		"test:a11y": "npx playwright test tests/a11y --config=playwright.config.ts",
		"test:e2e": "npx playwright test tests/e2e --config=playwright.config.ts",
		"preview": "vite preview"
	},
	"dependencies": {
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1",
		"@playwright/test": "1.62.1",
		"@repo/typescript-config": "file:../../libs/typescript-config",
		"@types/node": "22.20.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.4",
		"autoprefixer": "10.5.4",
		"globals": "15.15.0",
		"postcss": "8.5.25",
		"tailwindcss": "3.4.19",
		"typescript": "5.9.3",
		"vite": "8.1.5"
	}
}
